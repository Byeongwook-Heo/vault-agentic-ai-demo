#!/usr/bin/env bash
set -euo pipefail
umask 077

export DEBIAN_FRONTEND=noninteractive
if [[ -f /etc/apt/sources.list ]]; then
  sed -i \
    -e 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' \
    -e 's|http://security.ubuntu.com|https://security.ubuntu.com|g' \
    /etc/apt/sources.list
fi
if [[ -d /etc/apt/sources.list.d ]]; then
  sed -i \
    -e 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' \
    -e 's|http://security.ubuntu.com|https://security.ubuntu.com|g' \
    /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true
fi
apt-get update -qq
apt-get install -y -qq ca-certificates curl jq openssl unzip awscli

vault_version="${vault_version}"
vault_archive="vault_${vault_version}_linux_amd64.zip"
vault_url="https://releases.hashicorp.com/vault/${vault_version}"
install_dir="$(mktemp -d)"
trap 'rm -rf "$${install_dir}"' EXIT
curl --fail --silent --show-error --location "$${vault_url}/$${vault_archive}" --output "$${install_dir}/$${vault_archive}"
curl --fail --silent --show-error --location "$${vault_url}/vault_$${vault_version}_SHA256SUMS" --output "$${install_dir}/SHA256SUMS"
(
  cd "$${install_dir}"
  grep " $${vault_archive}$" SHA256SUMS | sha256sum --check --status
)
unzip -q "$${install_dir}/$${vault_archive}" -d "$${install_dir}"
install -m 0755 "$${install_dir}/vault" /usr/local/bin/vault

id vault >/dev/null 2>&1 || useradd --system --home /etc/vault.d --shell /usr/sbin/nologin vault
install -d -m 0750 -o vault -g vault /etc/vault.d /opt/vault/data /etc/vault.d/tls /var/log/vault

aws ssm get-parameter \
  --region "${aws_region}" \
  --name "${license_parameter_name}" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text > /etc/vault.d/vault.hclic
chown vault:vault /etc/vault.d/vault.hclic
chmod 0640 /etc/vault.d/vault.hclic

private_ip="$(hostname -I | awk '{print $1}')"
openssl genrsa -out /etc/vault.d/tls/ca.key 3072
openssl req -x509 -new -sha256 -days 90 \
  -key /etc/vault.d/tls/ca.key \
  -subj "/CN=${project_name} Vault demo CA" \
  -out /etc/vault.d/tls/ca.pem
openssl genrsa -out /etc/vault.d/tls/server.key 3072
openssl req -new \
  -key /etc/vault.d/tls/server.key \
  -subj "/CN=${private_dns_name}" \
  -out /etc/vault.d/tls/server.csr
cat > /etc/vault.d/tls/server.ext <<EOF
subjectAltName=DNS:${private_dns_name},IP:$${private_ip},IP:127.0.0.1
extendedKeyUsage=serverAuth
keyUsage=digitalSignature,keyEncipherment
EOF
openssl x509 -req -sha256 -days 90 \
  -in /etc/vault.d/tls/server.csr \
  -CA /etc/vault.d/tls/ca.pem \
  -CAkey /etc/vault.d/tls/ca.key \
  -CAcreateserial \
  -extfile /etc/vault.d/tls/server.ext \
  -out /etc/vault.d/tls/server.pem
chown -R vault:vault /etc/vault.d/tls
chmod 0600 /etc/vault.d/tls/ca.key /etc/vault.d/tls/server.key
chmod 0644 /etc/vault.d/tls/ca.pem /etc/vault.d/tls/server.pem

aws ssm put-parameter \
  --region "${aws_region}" \
  --name "${ca_parameter_name}" \
  --type String \
  --overwrite \
  --value file:///etc/vault.d/tls/ca.pem >/dev/null

curl --fail --silent --show-error --location \
  "https://truststore.pki.rds.amazonaws.com/${aws_region}/${aws_region}-bundle.pem" \
  --output /etc/vault.d/tls/rds-ca.pem
openssl crl2pkcs7 -nocrl -certfile /etc/vault.d/tls/rds-ca.pem \
  | openssl pkcs7 -print_certs -noout >/dev/null
chown vault:vault /etc/vault.d/tls/rds-ca.pem
chmod 0644 /etc/vault.d/tls/rds-ca.pem

cat > /etc/vault.d/vault.hcl <<EOF
ui                  = true
disable_mlock       = true
api_addr            = "https://${private_dns_name}:8200"
cluster_addr        = "https://${private_dns_name}:8201"
license_path        = "/etc/vault.d/vault.hclic"

listener "tcp" {
  address            = "0.0.0.0:8200"
  cluster_address    = "0.0.0.0:8201"
  tls_cert_file      = "/etc/vault.d/tls/server.pem"
  tls_key_file       = "/etc/vault.d/tls/server.key"
  tls_min_version    = "tls13"
}

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "${project_name}-vault-1"
}

seal "awskms" {
  region     = "${aws_region}"
  kms_key_id = "${unseal_kms_key_id}"
}
EOF
chown vault:vault /etc/vault.d/vault.hcl
chmod 0640 /etc/vault.d/vault.hcl

cat > /etc/systemd/system/vault.service <<'EOF'
[Unit]
Description=HashiCorp Vault Enterprise
Requires=network-online.target
After=network-online.target

[Service]
User=vault
Group=vault
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
SecureBits=keep-caps
AmbientCapabilities=CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYSLOG CAP_IPC_LOCK
ExecStart=/usr/local/bin/vault server -config=/etc/vault.d/vault.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
Environment=VAULT_LICENSE_PATH=/etc/vault.d/vault.hclic

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now vault
